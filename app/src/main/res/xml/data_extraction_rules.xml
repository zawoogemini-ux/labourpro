<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="labour_master_database" />
        <include domain="database" path="labour_master_database-wal" />
        <include domain="database" path="labour_master_database-shm" />
        <include domain="sharedpref" path="." />
        <include domain="file" path="backups" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="labour_master_database" />
        <include domain="database" path="labour_master_database-wal" />
        <include domain="database" path="labour_master_database-shm" />
        <include domain="sharedpref" path="." />
        <include domain="file" path="backups" />
    </device-transfer>
</data-extraction-rules>
